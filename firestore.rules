rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: user is authenticated AND has verified their email.
    // Applied to all data collections to prevent unverified accounts from
    // reading or writing operational data. (Phase 1 security fix)
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true && isMfaVerified();
    }

    // Helper: the user passed two-factor authentication on THIS sign-in.
    // The mfaAuthTime claim is set by the mfaVerify / mfaConfirmEnrol Cloud
    // Functions to the token's auth_time. A fresh password sign-in gets a new
    // auth_time, so a stale claim no longer matches. A missing claim denies.
    function isMfaVerified() {
      return request.auth != null && request.auth.token.mfaAuthTime == request.auth.token.auth_time;
    }

    // Helper: get user's role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: get user's scheme (backward compatibility)
    function getUserScheme() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schemeId;
    }

    // Helper: get user's schemes array (multi-scheme support)
    function getUserSchemes() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schemeIds;
    }

    // Helper: check if user has access to a scheme
    function hasSchemeAccess(docSchemeIds) {
      let userSchemes = getUserSchemes();
      return userSchemes != null && docSchemeIds != null && userSchemes.hasAny(docSchemeIds);
    }

    // Helper: backward compatibility for single schemeId
    function hasOldSchemeAccess(docSchemeId) {
      let userSchemes = getUserSchemes();
      return userSchemes != null && docSchemeId != null && docSchemeId in userSchemes;
    }

    // Helper: write-time check that every scheme on an incoming doc is one
    // the writing user actually belongs to. Stricter than hasSchemeAccess
    // (hasAny, used for reads) — used to stop a client from writing content
    // tagged to a scheme they don't belong to.
    function hasSchemeOwnership(docSchemeIds) {
      let userSchemes = getUserSchemes();
      return userSchemes != null && docSchemeIds != null && userSchemes.hasAll(docSchemeIds);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (getUserRole() == 'admin' && isMfaVerified())
      );

      // SECURITY FIX: Self-update is restricted to safe fields only.
      // This prevents a user from escalating their own role to 'admin' or
      // toggling flags like 'canCreateAdmins' or 'isArchived'.
      // Admins can update any field on any user document.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['displayName', 'activeSchemeId', 'lastLogoutAt', 'lastLoginAt', 'emailVerified', 'updatedAt'])) ||
        (getUserRole() == 'admin' && isMfaVerified())
      );

      // A user may only create their own document, and never with the 2FA flags or
      // archive flag set (those are written by Cloud Functions / admins only).
      // Otherwise a user could delete + re-create their doc claiming mfaEnrolled.
      // NOTE: `role` is still chosen by the signup client; moving signup to a Cloud
      // Function is the real fix and is out of scope for the 2FA work.
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['mfaEnrolled', 'mfaLockedUntil', 'isArchived']);

      // No direct deletes from clients. Admins delete users via the deleteUserAccount
      // Cloud Function (Admin SDK, bypasses these rules).
      allow delete: if false;
    }

    // 2FA secrets (hashed codes, trusted browsers, lock state).
    // Only the Cloud Functions (Admin SDK) touch this - no client access at all.
    match /mfa/{userId} {
      allow read, write: if false;
    }

    // OTP codes - admin only
    match /otpCodes/{otpId} {
      allow read, write: if isVerified() && getUserRole() == 'admin';
    }

    // Client OTPs
    match /clientOTPs/{otpId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      // SECURITY FIX: Split 'allow read: if true' into get vs list.
      // 'get' (single doc) is still public — needed for OTP validation during
      // signup before the user has a Firebase account.
      // 'list' (query all docs) is admin-only — prevents anyone from
      // enumerating all active OTP codes.
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // CCTV Operator Access Codes (separate from clientOTPs)
    match /cctvOperatorOTPs/{codeId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // Staff Invite Codes
    match /staffInviteCodes/{codeId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      // SECURITY FIX: Same as clientOTPs — allow single-doc read for signup
      // validation but block listing all invite codes.
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // Third Party Operator Codes — admin only
    match /thirdPartyOperatorCodes/{codeId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // Third Party Client Codes — admin only
    match /thirdPartyClientCodes/{codeId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // Third Party Live Operator Codes — admin only
    match /thirdPartyLiveOperatorCodes/{codeId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // Third Party CCTV Operator Codes — admin only
    match /thirdPartyCCTVOperatorCodes/{codeId} {
      allow write: if isVerified() && getUserRole() == 'admin';
      allow get: if true;
      allow list: if isVerified() && getUserRole() == 'admin';
    }

    // Incident Reports
    match /incidentReports/{reportId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'liveoperator' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyliveoperator' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'liveoperator' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient' ||
        getUserRole() == 'thirdpartyliveoperator'
      );

      allow update, delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // CCTV Check Forms
    match /cctvCheckForms/{formId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'cctvfaultoperator' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient' ||
        getUserRole() == 'thirdpartycctvoperator'
      );

      allow update, delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // Asset Damage Reports
    match /assetDamageReports/{reportId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient'
      );

      allow update, delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // Daily Occurrence Reports
    match /dailyOccurrenceReports/{reportId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          (resource.data.schemeIds != null && getUserSchemes() != null &&
           resource.data.schemeIds.hasAny(getUserSchemes())) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient'
      );

      allow update, delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // CCTV Faults Reports
    match /cctvFaultsReports/{reportId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'cctvfaultoperator' ||
        getUserRole() == 'thirdpartycctvoperator' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'cctvfaultoperator' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient' ||
        getUserRole() == 'thirdpartycctvoperator'
      );

      allow update: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') &&
          hasSchemeAccess(resource.data.schemeIds) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clientAcknowledged', 'acknowledgedAt', 'updatedAt'])
        ) ||
        ((getUserRole() == 'cctvfaultoperator' || getUserRole() == 'thirdpartycctvoperator') &&
          (hasSchemeAccess(resource.data.schemeIds) ||
           getUserScheme() == resource.data.schemeId ||
           (resource.data.schemeIds != null && getUserScheme() != null && getUserScheme() in resource.data.schemeIds)) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clientAcknowledged', 'clientNote', 'clientNotes', 'acknowledgedAt', 'updatedAt'])
        )
      );

      allow delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // CCTV Uploads
    match /cctvUploads/{uploadId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.scheme)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient'
      );

      allow update, delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // Body Cam Uploads (internal staff/client only — no third-party access)
    match /bodyCamUploads/{uploadId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' ||
        (getUserRole() == 'client' &&
          request.resource.data.uploadedBy.userId == request.auth.uid &&
          (
            hasSchemeOwnership(request.resource.data.schemeIds) ||
            hasOldSchemeAccess(request.resource.data.schemeId)
          )
        )
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        (getUserRole() == 'client' && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client'
      );

      allow update: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' ||
        (getUserRole() == 'client' &&
          resource.data.uploadedBy.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        )
      );

      allow delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin'
      );
    }

    // Dash Cam Uploads (internal staff/client only — no third-party access)
    match /dashCamUploads/{uploadId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' ||
        (getUserRole() == 'client' &&
          request.resource.data.uploadedBy.userId == request.auth.uid &&
          (
            hasSchemeOwnership(request.resource.data.schemeIds) ||
            hasOldSchemeAccess(request.resource.data.schemeId)
          )
        )
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        (getUserRole() == 'client' && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.schemeId)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client'
      );

      allow update: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' ||
        (getUserRole() == 'client' &&
          resource.data.uploadedBy.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        )
      );

      allow delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin'
      );
    }

    // Documents (staff share files / live links with clients, scheme-scoped)
    match /documents/{documentId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff' ||
        (getUserRole() == 'client' &&
          request.resource.data.uploadedBy.userId == request.auth.uid &&
          (
            hasSchemeOwnership(request.resource.data.schemeIds) ||
            hasOldSchemeAccess(request.resource.data.schemeId)
          )
        )
      );

      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') && (
          hasSchemeAccess(resource.data.schemeIds) ||
          hasOldSchemeAccess(resource.data.scheme)
        ))
      );

      allow list: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'client' ||
        getUserRole() == 'thirdpartystaff' ||
        getUserRole() == 'thirdpartyclient'
      );

      allow update: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff' ||
        (getUserRole() == 'client' &&
          resource.data.uploadedBy.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        )
      );

      allow delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // Activities (for notice board)
    match /activities/{activityId} {
      allow create: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );
      allow read: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff'
      );
      allow update, delete: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );
    }

    // Counters (for reference ID generation)
    match /counters/{counterId} {
      allow read, write: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'thirdpartystaff'
      );
    }

    // Staff Rota — admin + internal staff only. Third-party staff and all
    // client roles have no access at all (not even read).
    match /rotaStaff/{staffId} {
      allow read: if isVerified() && (
        getUserRole() == 'admin' || getUserRole() == 'staff'
      );
      allow write: if isVerified() && getUserRole() == 'admin';
    }
    match /rotaShifts/{shiftId} {
      allow read: if isVerified() && (
        getUserRole() == 'admin' || getUserRole() == 'staff'
      );
      // Clearing/rejecting a shift is open to staff and admin.
      allow delete: if isVerified() && (
        getUserRole() == 'admin' || getUserRole() == 'staff'
      );
      // Only admins may mark a holiday as approved; staff writes are limited to
      // non-approved states (e.g. a pending holiday request or a normal shift).
      allow create, update: if isVerified() && (
        getUserRole() == 'admin' ||
        (getUserRole() == 'staff' &&
          request.resource.data.get('status', 'pending') != 'approved')
      );
    }
    match /rotaBankHolidays/{holidayId} {
      allow read: if isVerified() && (
        getUserRole() == 'admin' || getUserRole() == 'staff'
      );
      allow write: if isVerified() && getUserRole() == 'admin';
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow create: if isVerified() && getUserRole() == 'admin';
      allow read: if isVerified() && getUserRole() == 'admin';
    }

    // Login Logs (audit trail of who signed in and when)
    // Any authenticated user can create their own login entry.
    // isSignedIn() used (not isVerified()) so the log is captured even if the
    // user hasn't verified their email yet — keeping the audit trail complete.
    // Only admins can read. TTL auto-deletes after 3 days.
    match /loginLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isVerified() && getUserRole() == 'admin';
    }

    // Scheme Stats (running totals — vehicles dispatched, etc.)
    match /schemeStats/{schemeId} {
      allow get: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') &&
          getUserSchemes() != null && schemeId in getUserSchemes())
      );
      allow write: if isVerified() && (
        getUserRole() == 'staff' || getUserRole() == 'admin' || getUserRole() == 'thirdpartystaff'
      );
    }

    // CCTV Uptime Cache (computed summaries, shared across users, 15-min TTL)
    match /cctvUptimeCache/{docId} {
      allow read, write: if isVerified();
    }

    // Scheme Stats + Time Series Cache (computed summaries, shared across users,
    // 15-min TTL). Unlike cctvUptimeCache, this embeds real incident detail
    // (locations, who reported them, descriptions) for the dashboard's
    // drill-down feature — not just an aggregate percentage — so reads are
    // scheme-scoped the same way the underlying incidentReports collection
    // is, rather than open to any verified user. Doc IDs are guessable
    // (schemeId + dates), so this scoping is the only thing stopping a user
    // on one scheme from reading another scheme's cached incident data.
    match /schemeStatsCache/{docId} {
      allow read: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') &&
          getUserSchemes() != null && resource.data.schemeId in getUserSchemes())
      );
      // Write is populated by the same read path that computes the data (a
      // cache-aside fill), so it's scoped the same way as the read it backs.
      allow write: if isVerified() && (
        getUserRole() == 'admin' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'thirdpartystaff' ||
        ((getUserRole() == 'client' || getUserRole() == 'thirdpartyclient') &&
          getUserSchemes() != null && request.resource.data.schemeId in getUserSchemes())
      );
    }

    // Collection count cache (computed dashboard totals, shared, 15-min TTL)
    match /collectionStatsCache/{docId} {
      allow read, write: if isVerified();
    }

    // Schemes (admin-managed list of schemes). Everyone verified needs to read it;
    // only admins change it. Schemes in use are archived (active: false); the admin
    // page only deletes a scheme after checking nothing references it. Rules cannot
    // count other documents, so that check lives in schemeService.deleteScheme.
    match /schemes/{schemeId} {
      allow read: if isVerified();
      allow create, update, delete: if isVerified() && getUserRole() == 'admin';
    }

    // Alert email recipients per scheme. Admin only: unlike `schemes` this holds real
    // email addresses, which clients and staff must not be able to read.
    // Cloud Functions read it with the admin SDK, which bypasses these rules.
    match /schemeAlerts/{schemeId} {
      allow read, write: if isVerified() && getUserRole() == 'admin';
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
